        {
          "name": "/login",
          "item": [
            {
              "name": "POST requests",
              "item": [
                {
                  "name": "Returns 200 and success login",
                  "event": [
                    {
                      "listen": "test",
                      "script": {
                        "exec": [
                          "const response = pm.response.json();\r",
                          "\r",
                          "// 1. Получаем токен из куки\r",
                          "var cookieToken = pm.cookies.get(\"access_token\");\r",
                          "\r",
                          "// 2. Сохраняем в окружение (только если кука существует)\r",
                          "if (cookieToken) {\r",
                          "    pm.environment.set(\"accessToken\", cookieToken);\r",
                          "}\r",
                          "\r",
                          "// Сохранение сегодняшней даты\r",
                          "pm.environment.set(\"dateToday\", new Date().toISOString().split('T')[0]);\r",
                          "\r",
                          "pm.test(\"Status code is 200\", function () {\r",
                          "    pm.response.to.have.status(200);\r",
                          "});\r",
                          "\r",
                          "// Проверяем наличие полей в JSON (убрали проверку accessToken в теле, если он в куках)\r",
                          "pm.test(\"Response body contains 'userId' and 'email'\", function () {\r",
                          "    pm.expect(response).to.have.property(\"userId\");\r",
                          "    pm.expect(response).to.have.property(\"email\");\r",
                          "});\r",
                          "\r",
                          "pm.test(\"Response body contains correct email\", function () {\r",
                          "    pm.expect(response.email).to.eql(\"tester@example.com\");\r",
                          "});\r",
                          "\r",
                          "// Проверка наличия куки\r",
                          "pm.test(\"Cookie 'access_token' is present\", function () {\r",
                          "    pm.expect(pm.cookies.has(\"access_token\")).to.be.true;\r",
                          "    pm.expect(pm.cookies.get(\"access_token\")).to.not.be.empty;\r",
                          "});"
                        ],
                        "type": "text/javascript",
                        "packages": {},
                        "requests": {}
                      }
                    }
                  ],
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\r\n    \"email\": \"tester@example.com\",\r\n    \"password\": \"password1\"\r\n}",
                      "options": {
                        "raw": {
                          "language": "json"
                        }
                      }
                    },
                    "url": {
                      "raw": "{{baseUrl}}/auth/login",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "auth",
                        "login"
                      ]
                    }
                  },
                  "response": []
                }
              ]
            }
          ]
        }
