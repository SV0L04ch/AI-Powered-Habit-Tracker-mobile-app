          "item": [
            {
              "name": "POST requests",
              "item": [
                {
                  "name": "Returns 201 and token and userId",
                  "event": [
                    {
                      "listen": "test",
                      "script": {
                        "exec": [
                          "const response = pm.response.json();\r",
                          "\r",
                          "// Проверка, что статус-код 201\r",
                          "pm.test(\"Status code is 201\", function () {\r",
                          "    pm.response.to.have.status(201);\r",
                          "});\r",
                          "\r",
                          "// Проверка, что в теле ответа есть необходимые поля\r",
                          "pm.test(\"Response body contains \\\"userId\\\", \\\"email\\\", \\\"accessToken\\\" properties\", function () {\r",
                          "    pm.expect(response).to.has.property(\"userId\");\r",
                          "    pm.expect(response).to.has.property(\"email\");\r",
                          "});\r",
                          "\r",
                          "// Проверка, что в теле запроса есть корректный email\r",
                          "pm.test(\"Response body contains correct email\", function () {\r",
                          "    pm.expect(response.email).to.eql(\"tester@example.com\");\r",
                          "});"
                        ],
                        "type": "text/javascript",
                        "packages": {},
                        "requests": {}
                      }
                    }
                  ],
                  "protocolProfileBehavior": {
                    "disableCookies": false,
                    "disableUrlEncoding": false
                  },
                  "request": {
                    "auth": {
                      "type": "noauth"
                    },
                    "method": "POST",
                    "header": [],
                    "body": {
                      "mode": "raw",
                      "raw": "{\r\n    \"email\": \"tester@example.com\",\r\n    \"password\": \"password1\",\r\n    \"city\": \"Moscow\"\r\n}",
                      "options": {
