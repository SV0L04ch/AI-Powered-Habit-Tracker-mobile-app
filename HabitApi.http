@HabitApi_HostAddress = http://localhost:5432
@userId = 11111111-1111-1111-1111-111111111111
@habitId = 22222222-2222-2222-2222-222222222222

POST {{HabitApi_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Secret123",
  "city": "Moscow"
}

###

GET {{HabitApi_HostAddress}}/api/users/{{userId}}/habits
Accept: application/json

###

POST {{HabitApi_HostAddress}}/api/users/{{userId}}/habits
Content-Type: application/json

{
  "name": "Morning workout",
  "description": "20 minutes workout",
  "type": 1,
  "isEntertainment": false,
  "targetPerDay": 1,
  "plannedHour": 8,
  "penaltyDaysOnMiss": 2,
  "tags": ["health", "sport"]
}

###

POST {{HabitApi_HostAddress}}/api/users/{{userId}}/habits/{{habitId}}/entries
Content-Type: application/json

{
  "date": "2026-04-13",
  "status": 1,
  "quantity": 1,
  "note": "Completed"
}

###

GET {{HabitApi_HostAddress}}/api/stats/daily-summary?userId={{userId}}&date=2026-04-13
Accept: application/json

###

GET {{HabitApi_HostAddress}}/api/weather?city=Moscow&date=2026-04-13
Accept: application/json
